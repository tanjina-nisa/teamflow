# PostgreSQL connection string (Neon / Supabase / Render / RDS / local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teamflow
# Set to true for managed Postgres that requires TLS (Neon, Render, Supabase)
DATABASE_SSL=false
# Long random string. Required in production.
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed web origins, e.g. https://teamflow-saas.vercel.app
CORS_ORIGIN=http://localhost:3000
PORT=4000
# Where uploaded attachments are stored (use a persistent disk or swap for S3)
UPLOAD_DIR=./uploads
# Auto-create tables on boot. Set false once you manage migrations yourself.
DB_SYNC=true
